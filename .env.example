# ============================================================
# S.K.AUTOTRUCK — Environment Variables (EXAMPLE ONLY)
# Copy to .env and fill in real values for your environment.
# NEVER commit a real .env file. This file must only ever
# contain placeholder names, never real secrets.
# ============================================================

NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/somkiat.db

# CORS: the exact browser origin allowed to call this API (e.g.
# https://skautotruck.com). Required in production — with no wildcard
# ever sent. In development, if left unset, the actual requesting
# Origin is reflected back instead (see src/middleware/cors.js).
# ALLOWED_ORIGIN=

# Public customer website (Step 36): which single dealer's catalog the
# /api/public/* routes serve. Required for those routes to work at all
# — they fail closed (generic error, no details leaked) without it.
# PUBLIC_DEALER_ID=DEALER_SOMKIAT

# --- Reserved for future steps (NOT used/read in Step 30A) ---
# FACEBOOK_APP_SECRET=
# FACEBOOK_VERIFY_TOKEN=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# CLAUDE_API_KEY=
#
# Step 31 status: these 4 variables are now REQUIRED when NODE_ENV=production
# (see src/config/env.js) — the server will refuse to start without them.
# None of them exist in this development/build environment. See README
# "Step 31 status" for exactly what is and isn't tested as a result.
